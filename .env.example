# Loopback-only local testing. See deploy/README.md for HTTPS and production.
APP_HOSTNAME=bountydeck.test
AUTH_URL=http://bountydeck.test
CADDY_SITE=http://bountydeck.test
BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
# Leave empty to use APP_HOSTNAME for bundled TLS or the local example.
CADDY_NETWORK_ALIAS=
# The Keycloak admin console is only available on the loopback HTTP example.
CADDY_IDENTITY_ADMIN_ENABLED=true
OIDC_ISSUER=http://bountydeck.test/identity/realms/bountydeck
OIDC_CLIENT_ID=bountydeck
KEYCLOAK_SSL_REQUIRED=none

ATTACHMENT_TYPES=image/png,text/plain
ATTACHMENT_SCANNER=
BOUNTYDECK_GUEST_REPORTS=false
REPORT_EXPORTS_ENABLED=true
SMTP_FROM=
SMTP_ALLOW_PLAINTEXT=false
WEBHOOK_DESTINATIONS='{}'
NOTIFICATION_MAX_ATTEMPTS=6

# External REST/MCP is disabled until an OAuth audience is configured.
# Set to the canonical public AUTH_URL followed by /mcp.
INTEGRATION_AUDIENCE=
INTEGRATION_SCOPE=bountydeck.api
INTEGRATION_SERVICE_CLIENTS='{}'
INTEGRATION_ALLOW_HTTP=false

# Optional OTLP/HTTP JSON log export. Supply the full collector /v1/logs URL.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# Optional: mount a private file containing OTLP headers and set its container path.
BOUNTYDECK_OTLP_HEADERS_FILE=
